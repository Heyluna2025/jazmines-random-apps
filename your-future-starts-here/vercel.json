{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/", "destination": "/api" },
    { "source": "/join", "destination": "/api" },
    { "source": "/enter", "destination": "/enter.html" },
    { "source": "/c/:slug", "destination": "/api" },
    { "source": "/presenter", "destination": "/api" },
    { "source": "/p/:code", "destination": "/api" },
    { "source": "/x/:code", "destination": "/projector/index.html" },
    { "source": "/a/:code", "destination": "/audience/index.html" },
    { "source": "/demo", "destination": "/demo/index.html" },
    { "source": "/:code([A-HJ-NP-Za-hj-np-z2-9]{4})", "destination": "/audience/index.html" }
  ],
  "functions": {
    "api/index.js": { "includeFiles": "public/**" }
  }
}
