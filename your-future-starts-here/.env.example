# Copy to .env for local runs, or set these in your host's environment settings.

# Password for the presenter controls. Pick something you can type on a phone.
PRESENTER_PASSWORD=change-me

# Public address of the deployed app, used to build the QR code and join link.
# Leave blank to derive it from each request (works on Vercel, Render, Railway, Fly).
PUBLIC_URL=

# Shared storage (required on Vercel for a real audience; optional elsewhere).
# Vercel's Storage tab fills these in when you add Upstash Redis to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Local-only options
PORT=3000
# DATA_FILE=./data/sessions.json
